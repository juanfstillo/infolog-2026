# Copy to .env.docker on the server (not committed to git) and fill in APP_KEY.
# Used by docker-compose.prod.yml / docker/entrypoint.sh to write the container's .env.

APP_NAME=Infolog
APP_ENV=production
APP_DEBUG=false
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
# No domain yet: use the server IP. Update once a domain is pointed at this box.
APP_URL=http://204.168.199.131:8082

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=warning
